# Copy to .env; native Node.js 22: node --env-file=.env server/server.mjs
CONTROL_MODE=cloud
# Device pairing secret, separate from the browser password. Generate with:
# openssl rand -hex 24. Enter the same value in the USB "服务器接入" panel.
ESP32_DEVICE_TOKEN=
# Only CONTROL_MODE=proxy needs the local device IP:
# ESP32_URL=http://192.168.1.50
HOST=0.0.0.0
PORT=8000
# Generate your own password: openssl rand -hex 24. Login user: esp32.
ESP32_ACCESS_TOKEN=
# HTTPS deployment only: the exact external origin, without a path.
# PUBLIC_ORIGIN=https://esp32.example.com

# Docker binds to localhost by default; use 0.0.0.0 for LAN phone access.
GATEWAY_BIND=127.0.0.1
